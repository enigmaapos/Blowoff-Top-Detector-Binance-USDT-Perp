function getPhaseRank(phase) {
  if (!phase) return 999;
  const p = (typeof phase === 'object')
    ? (phase.phaseName || phase.phase || '')
    : phase;
  const s = String(p).toLowerCase();

  if (s.includes('blowoff')) return 1;
  if (s.includes('distribution')) return 2;
  if (s.includes('trend') || s.includes('early pump') || s.includes('takeoff')) return 2.5;
  if (s.includes('breakdown')) return 3;
  if (s.includes('crash')) return 4;
  if (s.includes('post-crash') || s.includes('flatline') || s.includes('post')) return 5;

  const m = s.match(/\d+/);
  return m ? Number(m[0]) : 999;
}

function getSimPhaseRank(simPhase) {
  if (!simPhase) return 999;
  const s = String(simPhase).toLowerCase();

  if (s.includes('blowoff')) return 1;
  if (s.includes('distribution')) return 2;
