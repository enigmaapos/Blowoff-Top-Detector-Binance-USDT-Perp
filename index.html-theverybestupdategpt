<script>
/* ======================================================
   Full detector with Correction Guide sorting (client-side).
   ====================================================== */

const API_BASE = 'https://fapi.binance.com';
const blacklist = ["ALPACAUSDT","BNXUSDT","ALPHAUSDT","OCEANUSDT","DGBUSDT","AGIXUSDT","LINAUSDT","LOKAUSDT","KEYUSDT","MDTUSDT","LOOMUSDT","RENUSDT","OMNIUSDT","SLERFUSDT","STMXUSDT","UXLINKUSDT","BSWUSDT","NEIROETHUSDT","VIDTUSDT","TROYUSDT","BAKEUSDT","AMBUSDT","MEMEFIUSDT","NULSUSDT","HIFIUSDT","LEVERUSDT","XEMUSDT","STRAXUSDT","COMBOUSDT","AI16ZUSDT"];

const el = {
  prefilter: document.getElementById('prefilter'),
  delay: document.getElementById('delay'),
  interval: document.getElementById('interval'),
  threshold: document.getElementById('threshold'),
  startBtn: document.getElementById('startBtn'),
  stopBtn: document.getElementById('stopBtn'),
  oneShot: document.getElementById('oneShot'),
  message: document.getElementById('message'),
  bar: document.getElementById('bar'),
  tableView: document.getElementById('tableView'),
  cardView: document.getElementById('cardView'),
  debug: document.getElementById('debug'),
  safetyStatus: document.getElementById('safetyStatus'),
  countdown: document.getElementById('countdown'),
  tf15: document.getElementById('tf15'),
  tf1h: document.getElementById('tf1h'),
  tf4h: document.getElementById('tf4h'),
  sensitivity: document.getElementById('sensitivity'),
  sensVal: document.getElementById('sensVal'),
  condAlert: document.getElementById('condAlert'),
  accumAlertThreshold: document.getElementById('accumAlertThreshold'),
  showShort: document.getElementById('showShort'),
  tradeInterpret: document.getElementById('tradeInterpret'),
  // sorting elements (populated below)
  sortBy: document.getElementById('sortBy'),
  sortDir: document.getElementById('sortDir')
};

  // ---------------------- Symbol search + single-symbol analyzer ----------------------
// Wire new elements
el.symbolSearch = document.getElementById('symbolSearch');
el.symbolSearchBtn = document.getElementById('symbolSearchBtn');
el.symbolClearCache = document.getElementById('symbolClearCache');
el.symbolStatus = document.getElementById('symbolStatus');

// Simple in-memory cache for symbol analysis & exchangeInfo
const symbolCache = new Map(); // key -> { ts, data }
const CACHE_TTL = 1000 * 60 * 5; // 5 minutes TTL

// Small rate-limiter for manual symbol lookups (token bucket-ish)
let lastSymbolReq = 0;
const MIN_MS_BETWEEN_SYMBOL_REQ = 800; // 0.8s between manual lookups (adjust as needed)

// Optional: cached exchangeInfo to validate symbol (fetch once, lazy)
let exchangeInfoCache = null;
async function ensureExchangeInfo() {
  if(exchangeInfoCache && (Date.now() - exchangeInfoCache.ts) < 1000*60*30) return exchangeInfoCache.data;
  try {
    const data = await safeFetch(API_BASE + '/fapi/v1/exchangeInfo', { allowIfNotRunning: true });
    exchangeInfoCache = { ts: Date.now(), data };
    return data;
  } catch(e){
    // if fails, we won't block symbol analysis — just proceed (we'll try to fetch klines)
    console.warn('exchangeInfo fetch failed:', e.message);
    return null;
  }
}

  // keep a set to avoid spamming the same symbol repeatedly
const alertedSymbols = new Set();

// cache audio element
const scoreAudio = document.getElementById('scoreAlert');

// Add an "unlock" click so browsers allow playback
const enableBtn = document.getElementById('enableSound');
if (enableBtn) {
  enableBtn.addEventListener('click', async () => {
    try {
      // attempt a short play/pause to unlock audio on many browsers
      await scoreAudio.play();
      scoreAudio.pause();
      scoreAudio.currentTime = 0;
      enableBtn.innerText = 'Sound Enabled';
      enableBtn.disabled = true;
      console.log('Audio unlocked (user gesture).');
    } catch (e) {
      console.warn('Audio unlock failed:', e);
      enableBtn.innerText = 'Enable Sound (failed)';
    }
  });
}

// Robust play function with debug info
function playScoreAlert(symbol) {
  if (!scoreAudio) { console.warn('scoreAudio missing'); return; }
  try {
    scoreAudio.currentTime = 0; // rewind to start
    const p = scoreAudio.play();
    if (p && typeof p.catch === 'function') p.catch(err => {
      console.warn('play() rejected:', err);
    });
    console.log('Attempted play for', symbol);
  } catch (err) {
    console.warn('playScoreAlert error', err);
  }
}

// Validate quick: symbol must end with USDT for futures perpetual USDT pairs
function looksLikeUSDTPerp(sym) {
  if(!sym) return false;
  // common convention: futures perpetual on Binance use USDT pairs and show in /fapi endpoints
  return sym.toUpperCase().endsWith('USDT');
}

// Helper: read & set cache
function getCachedSymbol(sym) {
  const k = sym.toUpperCase();
  const row = symbolCache.get(k);
  if(!row) return null;
  if(Date.now() - row.ts > CACHE_TTL) { symbolCache.delete(k); return null; }
  return row.data;
}
function setCachedSymbol(sym, data) {
  const k = sym.toUpperCase();
  symbolCache.set(k, { ts: Date.now(), data });
}

// Clear cache button
el.symbolClearCache.addEventListener('click', () => {
  symbolCache.clear();
  exchangeInfoCache = null;
  el.symbolStatus.innerText = 'Symbol cache cleared.';
  setTimeout(()=> el.symbolStatus.innerText = '', 2600);
});

  // Helper: cheap fallback scoring when res.score is missing
function computeSimpleScore(res){
  // simple heuristic — tuned to mimic blowoff-ish signals enough for badges
  let s = 0;
  const v = res || {};
  const volSpike = Number(v.volSpike4 || v.volSpike || 0);
  const rsi4 = Number(v.rsi4h || v.rsi || 0);
  const wick = Number(v.wickRatio4 || 0);
  const emaDist = Number(v.ema70DistPct || 0);

  if(volSpike >= 5) s += 3;
  else if(volSpike >= 3) s += 2;
  else if(volSpike >= 1.5) s += 1;

  if(rsi4 >= 95) s += 3;
  else if(rsi4 >= 85) s += 2;
  else if(rsi4 >= 70) s += 1;

  if(wick >= 4) s += 2;
  else if(wick >= 2) s += 1;

  if(emaDist >= 100) s += 2;
  else if(emaDist >= 50) s += 1;

  // clamp to small integer
  return Math.max(0, Math.min(10, Math.round(s)));
}

  function classifySimilarityPhase(sim) {
  sim = Number(sim) || 0;
  if (sim < 0.20) return "Trend / Early Pump";
  if (sim < 0.35) return "Blowoff Forming";
  if (sim < 0.55) return "Blowoff / Distribution";
  if (sim < 0.80) return "Breakdown / Crash Phase";
  return "Flatline / Post-Crash";
}

  /* =====================
   Scan ALL USDT perpetuals for:
     - accumCombined.confidence < 50
     - preCrash.confidence    < 50
   Uses existing analyzeSymbol(sym) function & rate-limit safety.
   Inserts results into console + returns { lowAccum, lowPreCrash }.
   ===================== */

// configuration
const FULL_SCAN_MIN_DELAY_MS = 600;    // delay between per-symbol requests (adjust if you're getting rate-limited)
const FULL_SCAN_BATCH_SIZE = 6;        // optional: process in small batches to yield to UI (not parallelized here)
const THRESH = 50;                     // threshold 'below 50'
async function scanAllPerpsForBelow50({minDelay=FULL_SCAN_MIN_DELAY_MS, batchSize=FULL_SCAN_BATCH_SIZE} = {}) {
  // 1) fetch all tickers
  let tickers;
  try {
    tickers = await safeFetch(API_BASE + '/fapi/v1/ticker/24hr', { allowIfNotRunning: true });
  } catch (err) {
    el.scanStatus && (el.scanStatus.innerText = `Failed to fetch tickers: ${err.message}`);
    throw err;
  }

  // filter only USDT perpetuals and remove blacklist
  const symbols = (tickers || [])
    .filter(t => t.symbol && t.symbol.endsWith('USDT') && !blacklist.includes(t.symbol))
    .map(t => t.symbol.toUpperCase());

  el.scanStatus && (el.scanStatus.innerText = `Found ${symbols.length} USDT pairs — scanning (safe mode)...`);

  const lowAccum = [];     // accumCombined.confidence < THRESH
  const lowPreCrash = [];  // preCrash.confidence < THRESH
  const errors = [];

  // helper to throttle & respect safety pause
  async function safeAnalyze(sym) {
    // If the global safety pause indicates we should not run, wait and retry
    if (typeof checkSafetyAndMaybePause === 'function' && checkSafetyAndMaybePause()) {
      // sleep a bit before retrying (gives safety pause time to reset)
      await delay(Math.max(800, minDelay));
    }
    try {
      // enforce minimum inter-call delay
      await delay(minDelay);
      // perform analysis using your existing function (which returns accumCombined & preCrash)
      const res = await analyzeSymbol(sym, { allowIfNotRunning: true });
      return res;
    } catch (err) {
      return { error: err.message || String(err), symbol: sym };
    }
  }

  // sequential scan (safe). We keep this sequential to avoid bursts that trigger rate limits.
  for (let i = 0; i < symbols.length; i++) {
    const sym = symbols[i];
    try {
      el.scanStatus && (el.scanStatus.innerText = `(${i+1}/${symbols.length}) ${sym} — analyzing...`);
      const res = await safeAnalyze(sym);

      if(!res || res.error) {
        errors.push({ symbol: sym, error: res ? res.error : 'no response' });
        continue;
      }

      // ensure we have the computed fields (these are created inside analyzeSymbol)
      const accumConf = (res.accumCombined && typeof res.accumCombined.confidence === 'number') ? res.accumCombined.confidence : null;
      const preCrashConf = (res.preCrash && typeof res.preCrash.confidence === 'number') ? res.preCrash.confidence : null;

      // accumulate results if below threshold
      if (accumConf !== null && accumConf < THRESH) {
        lowAccum.push({ symbol: sym, accumConfidence: accumConf, simPhase: res.simPhase || res.sim, phase: res.phase || null });
      }
      if (preCrashConf !== null && preCrashConf < THRESH) {
        lowPreCrash.push({ symbol: sym, preCrashConfidence: preCrashConf, simPhase: res.simPhase || res.sim, phase: res.phase || null });
      }

    } catch (err) {
      errors.push({ symbol: sym, error: err.message || String(err) });
    }
    // small safeguard: if safety triggers, break early (or continue after pause)
    if (typeof checkSafetyAndMaybePause === 'function' && checkSafetyAndMaybePause()) {
      // Wait long enough for safety pause to clear
      await delay( (typeof SAFETY_PAUSE === 'number' ? SAFETY_PAUSE : 30) * 1000 + 500 );
    }
  }

  el.scanStatus && (el.scanStatus.innerText = `Scan complete. lowAccum: ${lowAccum.length}, lowPreCrash: ${lowPreCrash.length}, errors: ${errors.length}`);

  // optional: sort alphabetically
  lowAccum.sort((a,b) => a.symbol.localeCompare(b.symbol));
  lowPreCrash.sort((a,b) => a.symbol.localeCompare(b.symbol));

  // display in debug area and console (you can adapt rendering)
  console.log('=== lowAccum (<50) ===', lowAccum);
  console.log('=== lowPreCrash (<50) ===', lowPreCrash);
  if(el.debug) el.debug.innerText = `lowAccum:${lowAccum.length} lowPreCrash:${lowPreCrash.length} errors:${errors.length}`;

  return { lowAccum, lowPreCrash, errors };
}

// USAGE example: attach to a button or call from console
// scanAllPerpsForBelow50().then(r => console.table(r.lowAccum)).catch(e=>console.error(e));


(async function(){
  const runBtn = document.getElementById('runBelow50Btn');
  const note = document.getElementById('runBelow50Note');
  const resultsContainer = document.getElementById('below50Results');

  function makeTable(title, rows, columns) {
    // columns: [{key:'symbol', label:'Symbol'}, ...]
    const wrap = document.createElement('div');
    wrap.className = 'card-panel';
    const h = document.createElement('h3');
    h.style.fontSize = '14px';
    h.style.margin = '0 0 8px 0';
    h.innerText = `${title} (${rows.length})`;
    wrap.appendChild(h);

    if(!rows.length){
      const p = document.createElement('div');
      p.className = 'small';
      p.innerText = 'None';
      wrap.appendChild(p);
      return wrap;
    }

    // CSV download
