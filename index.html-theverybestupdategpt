    // volume spike (uses normalized vol spike)
    if(result.volSpike4 !== null && result.volSpike4 >= 1.8) s++;
    // wick/climax (slightly adjusted threshold to match queue)
    if(result.wickRatio4 !== null && result.wickRatio4 >= 1.6) s++;
    // big EMA stretch (tweak threshold to match your queue logic)
    if(result.ema70DistPct && Math.abs(result.ema70DistPct) >= 20) s++;
    // lower highs / breakdown
    if(result.lowerHigh) s++;
    // placeholder for other checks your queue uses (capitulation, dead-cat etc.)
    // e.g. if(result.preCrash && result.preCrash.someFlag) s++;

    result.score = s;
    

    if (result.score === 3) {
  if (!alertedSymbols.has(result.symbol)) {
    alertedSymbols.add(result.symbol);
    playScoreAlert(result.symbol);
  }
}

      // Independent Cycle Match + Blowoff Match; Correction Guide stays separate.
      applyCycleScores(result);

