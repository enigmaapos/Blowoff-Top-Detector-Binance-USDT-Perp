function getCorrectionRank(r) {
  const cg = r && r.correctionGuide ? r.correctionGuide : {};
  const code = String(cg.code || '').toUpperCase();

  const rank = {
    SIGNIFICANT_CORRECTION_CONFIRMED: 100,
    CORRECTION_DEVELOPING: 90,
    HIGH_CORRECTION_RISK_MANIA: 80,
    HIGH_CORRECTION_RISK: 70,
    VULNERABILITY_INCREASING: 60,
    OVERBOUGHT_STRONGLY_SUPPORTED: 40,
    OVERBOUGHT_CONTINUATION_SUPPORTED: 30,
    POST_CORRECTION_RECOVERY: 20,
    NO_SIGNIFICANT_CORRECTION_SIGNAL: 0
  };

  if (Object.prototype.hasOwnProperty.call(rank, code)) return rank[code];

  // Fallback for older result objects that only have a label.
  const label = String(cg.label || '').toLowerCase();
  if (label.includes('extreme')) return 100;
  if (label.includes('high')) return 80;
  if (label.includes('medium')) return 60;
  if (label.includes('low')) return 30;

  return 0;
}

function getNumeric(v, fallback = null) {
  if (v === null || typeof v === 'undefined' || v === '') return fallback;
  if (typeof v === 'number') return Number.isFinite(v) ? v : fallback;

  const n = Number(String(v).replace(/,/g, '').replace(/%/g, '').trim());
  return Number.isFinite(n) ? n : fallback;
}

function getText(v) {
  if (v === null || typeof v === 'undefined') return '';
  return String(v).trim().toLowerCase();
}

// Extract exactly one sortable value for every select option.
function getValueForKey(r, key) {
  if (!r) return null;

  switch (key) {
    case 'correctionRank':
      return getCorrectionRank(r);

    case 'correctionConfidence':
      return getNumeric(r.correctionGuide && r.correctionGuide.confidence, 0);

    case 'accum':
      return getNumeric(r.accumCombined && r.accumCombined.confidence, 0);

    case 'rsi4h':
      return getNumeric(r.rsi4h, 0);

    case 'score':
      return getNumeric(r.score, 0);

    case 'preCrash': {
      const p = r.preCrash || {};
      return getNumeric(
        p.confidence,
        getNumeric(p.prob, getNumeric(p.score, getNumeric(p.pts, 0)))
      );
    }

    case 'similarity':
      return getNumeric(r.similarity, 0);

    case 'ema70DistPct':
      // Sort by the displayed magnitude of the EMA stretch.
      return Math.abs(getNumeric(r.ema70DistPct, 0));

    case 'last':
      return getNumeric(r.closeNow, 0);

    case 'symbol':
      return getText(r.symbol);

    case 'volSpike':
      return getNumeric(r.volSpike4, 0);

    case 'vol1d':
      return getNumeric(r.volume1d, 0);

    case 'vol4h':
      return getNumeric(r.volume4h, 0);

    case 'vol15m':
      return getNumeric(r.volume15m, 0);

    case 'phase':
      return getText(
        typeof r.phase === 'object'
          ? (r.phase.phaseName || r.phase.phase || '')
          : r.phase
      );

    case 'phaseRank':
      return getPhaseRank(r.phase);

    case 'simPhase':
      return getText(r.simPhase);

    case 'simPhaseRank':
      return getSimPhaseRank(r.simPhase);

    default:
      return null;
  }
}

// Stable comparator:
// - numeric values sort numerically
// - Symbol/phase text sorts alphabetically
// - missing values always go to the end
// - ties use score, similarity, then symbol for deterministic results
// - Asc/Desc applies to the selected field and tie-breakers
function sortResults(results) {
  if (!Array.isArray(results)) return results;

  const key = (el.sortBy && el.sortBy.value)
    ? el.sortBy.value
    : 'correctionRank';

  const direction = sortDesc ? -1 : 1;

  function compareValues(a, b) {
    const aMissing = a === null || typeof a === 'undefined' ||
      (typeof a === 'number' && !Number.isFinite(a));
    const bMissing = b === null || typeof b === 'undefined' ||
      (typeof b === 'number' && !Number.isFinite(b));

    // Missing values always last, regardless of Asc/Desc.
    if (aMissing && bMissing) return 0;
    if (aMissing) return 1;
    if (bMissing) return -1;

    if (typeof a === 'number' && typeof b === 'number') {
      if (a === b) return 0;
      return a < b ? -1 : 1;
    }

    const sa = String(a).toLowerCase();
    const sb = String(b).toLowerCase();

    if (sa === sb) return 0;
    return sa < sb ? -1 : 1;
  }

  results.sort((a, b) => {
    let cmp = compareValues(
      getValueForKey(a, key),
      getValueForKey(b, key)
    );

    if (cmp !== 0) return cmp * direction;

    // Deterministic tie-breakers. Keep the selected sort direction
    // so Asc/Desc genuinely controls the whole ordering.
    cmp = compareValues(
      getNumeric(a && a.score, 0),
      getNumeric(b && b.score, 0)
    );
    if (cmp !== 0) return cmp * direction;

    cmp = compareValues(
      getNumeric(a && a.similarity, 0),
      getNumeric(b && b.similarity, 0)
    );
    if (cmp !== 0) return cmp * direction;

    return compareValues(
      getText(a && a.symbol),
      getText(b && b.symbol)
    ) * direction;
  });

  return results;
}

// ===== Filtering =====
let showOnlyDist = false;
const distKeywords = ['distribution', 'breakdown'];

function filterResultsForDist(results) {
  if (!showOnlyDist) return results;

  return results.filter(r => {
    if (!r) return false;

    let phaseText = '';

    if (r.phase) {
      if (typeof r.phase === 'string') {
        phaseText = r.phase.toLowerCase();
      } else if (typeof r.phase === 'object') {
        phaseText = String(
          r.phase.phaseName || r.phase.phase || ''
        ).toLowerCase();
      }
    }

    if (!phaseText && r.simPhase) {
      phaseText = String(r.simPhase).toLowerCase();
    }

    return distKeywords.some(k => phaseText.includes(k));
  });
}

// One render path for EVERY scan and EVERY sort action.
function applyFilterAndSortThenRender(results) {
  if (!Array.isArray(results)) return;

  // Always keep the complete, unsorted source results.
  window.lastScanResults = results;

  const arr = filterResultsForDist(results.slice());
  sortResults(arr);

  renderResponsiveResults(arr);
  updateTradingInterpretation(arr);
}

