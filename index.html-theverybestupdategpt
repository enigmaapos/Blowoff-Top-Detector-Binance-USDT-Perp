/* ---------- UTIL ---------- */
function delay(ms){ return new Promise(r=>setTimeout(r,ms)); }
function sma(arr,n){ if(!arr||arr.length<n) return null; let s=0; for(let i=arr.length-n;i<arr.length;i++) s+=arr[i]; return s/n; }
function ema(arr,p){ if(!arr||arr.length===0) return null; const k=2/(p+1); let e=arr[0]; for(let i=1;i<arr.length;i++) e = arr[i]*k + e*(1-k); return e; }
function rsiFromCloses(closes,period=14){ if(!closes||closes.length<=period) return null; let g=0,l=0; for(let i=closes.length-period;i<closes.length;i++){ const d=closes[i]-closes[i-1]; if(d>0) g+=d; else l+=Math.abs(d);} const ag=g/period, al=l/period; if(al===0) return 100; const rs=ag/al; return 100 - (100/(1+rs)); }
function pct(a,b){ return b===0?0:((a-b)/b)*100; }

/* ==========================================================
   FINAL CORRECTION GUIDE — COMPLETE MEMORY
   Reference cases:
   AVAAI / SANTOS / GPS / TRIA / BTW / HEMI / GALA / WIF / ONG

   CORE RULES
   ----------------------------------------------------------
   RSI       = overbought / overheating warning
   ACCUM     = continuation support / remaining upside
   EMA EXT   = degree of price overextension
   VOLUME    = participation / possible exhaustion
   WICK      = rejection / distribution evidence
   STRUCTURE = lower-high / downside confirmation
   EMA200    = materially deep correction confirmation

   IMPORTANT:
   - High RSI alone is NOT a significant-correction signal.
   - High RSI + strong accumulation can still continue upward.
   - Accumulation is NOT a standalone crash predictor.
   - Weak accumulation increases vulnerability when other warning
     signals agree, but does not by itself confirm a crash.
   - "HIGH CORRECTION RISK" is NOT the same as "SIGNIFICANT
     CORRECTION CONFIRMED."
   - A significant/deep correction is confirmed when EMA stretch is
     negative, meaning price is below EMA200.
   - Negative EMA stretch is the key significant-correction confirmation.
   - The previous ~20% decline requirement is NOT required for confirmation.
   - GALA / WIF reinforce the distinction between overbought risk
     and confirmed deep correction.
   - ONG reinforces that even an extreme blowoff/manic setup can
     remain a pre-correction warning until actual price decline
     and EMA200 confirmation occur.
   ========================================================== */

function getAccumulationStrength(accum) {
  accum = Number(accum) || 0;

  if (accum >= 70) {
    return {
      code: "VERY_STRONG",
      label: "VERY STRONG CONTINUATION SUPPORT"
    };
  }

  if (accum >= 60) {
    return {
      code: "STRONG",
      label: "STRONG CONTINUATION SUPPORT"
    };
  }

  if (accum >= 50) {
    return {
      code: "NEUTRAL",
      label: "NEUTRAL / MIXED SUPPORT"
    };
  }

  if (accum >= 40) {
    return {
      code: "WEAK",
      label: "WEAK CONTINUATION SUPPORT"
    };
  }

  return {
    code: "LOW",
    label: "LOW CONTINUATION SUPPORT"
  };
}


function calculateEmaStretch(price, emaValue) {
  price = Number(price);
  emaValue = Number(emaValue);
  if (!Number.isFinite(price) || !Number.isFinite(emaValue) || emaValue <= 0) return null;
  return ((price - emaValue) / emaValue) * 100;
}

/* ============================================================
   FINAL CORRECTION GUIDE ENGINE
   4H RSI + 4H accumulation = warning inputs
   EMA70 = extension input
   15m EMA200 = SIGNIFICANT CORRECTION CONFIRMATION
   ============================================================ */
function getCorrectionGuide(item) {
  item = item || {};
  const price = Number(item.closeNow ?? item.last ?? item.price ?? 0) || 0;
  const rsi4h = Number(item.rsi4h) || 0;
  const accum4h = Number((item.accumChecks || []).find(x => x.tf === '4h')?.result?.confidence ?? 0) || 0;
  const accumCombined = Number(item.accumCombined?.confidence ?? item.accum ?? accum4h) || 0;
  const ema70Stretch = Number(item.ema70DistPct ?? 0) || 0;
  const wickRatio4h = Number(item.wickRatio4 ?? 0) || 0;
  const volumeSpike4h = Number(item.volSpike4 ?? 1) || 1;
  const rawDropFromPeak = Number(item.dropPctFromPeak ?? 0) || 0;
  const dropFromPeak = Math.min(0, rawDropFromPeak);
  const lowerHigh = !!item.lowerHigh;
  const higherLow = !!item.higherLow || !!item.hasHigherLow;

  const ema200_15 = Number(item.ema200_15 ?? item.ema20015 ?? item.ema200_15m ?? 0) || 0;
  const ema200Stretch15 = calculateEmaStretch(price, ema200_15);

  const rsi15 = Number(item.rsi15) || 0;
  const rsi1h = Number(item.rsi1h) || 0;
  const ema14_15 = Number(item.ema14_15 ?? item.ema14_15m ?? 0) || 0;
  const ema21_15 = Number(item.ema21_15 ?? item.ema21_15m ?? 0) || 0;
  const belowShort15 = price > 0 && ema14_15 > 0 && ema21_15 > 0 && price < ema14_15 && price < ema21_15;
  const rsiFalling = rsi15 < 50 && rsi1h < 60;
  const meaningfulDecline = rawDropFromPeak <= -5;
  const activeDownside = meaningfulDecline || lowerHigh || belowShort15 || rsiFalling;

  const recentPeak4h = Number(item.recentPeak4h ?? 0) || null;
  const base = {
    accumulation: getAccumulationStrength(accumCombined),
    emaDistance: ema200Stretch15,
    emaDist: ema200Stretch15,
    ema200: ema200_15,
    ema200_15,
    ema200Stretch15,
    ema70Stretch,
    currentPrice: price,
    recentPeak4h,
    ema200Position: ema200Stretch15 === null ? 'UNAVAILABLE' : (ema200Stretch15 < 0 ? 'BELOW' : 'ABOVE'),
    ema200PositionLabel: ema200Stretch15 === null ? '⚪ EMA200 UNAVAILABLE' : (ema200Stretch15 < 0 ? '🔴 BELOW 15m EMA200' : '🟢 ABOVE 15m EMA200'),
    lowerHigh,
    dropFromPeak: rawDropFromPeak,
    actualDeclinePct: Math.abs(rawDropFromPeak)
  };

  // MASTER RULE — nothing above this can override it.
  if (ema200Stretch15 !== null && ema200Stretch15 < 0) {
    return {
      code:'SIGNIFICANT_CORRECTION_CONFIRMED',
      label:'🔴 SIGNIFICANT CORRECTION CONFIRMED',
      level:'CONFIRMED SIGNIFICANT CORRECTION',
      color:'#ff3f3f', confidence:100,
      ...base,
      reasons:[
        `15m EMA200 stretch ${ema200Stretch15.toFixed(2)}%`,
        'Price is below the 15m EMA200',
        'Master significant-correction confirmation'
      ]
    };
  }

  const nearEma200 = ema200Stretch15 !== null && ema200Stretch15 >= 0 && ema200Stretch15 <= 5;
  if (nearEma200 && accumCombined >= 45 && !lowerHigh && !meaningfulDecline) {
    return {
      code:'POST_CORRECTION_RECOVERY',
      label:'⚫ POST-CORRECTION / STABILIZATION',
      level:'STABILIZATION', color:'#8e44ad', confidence:75,
      ...base,
      reasons:[
        'Price is near the 15m EMA200',
        `Accumulation ${accumCombined}%`,
        'Selling pressure appears to be stabilizing'
      ]
    };
  }

  if (ema200Stretch15 !== null && ema200Stretch15 >= 0 && activeDownside && (rsi4h >= 70 || accumCombined < 50 || meaningfulDecline)) {
    return {
      code:'CORRECTION_DEVELOPING', label:'🟠 CORRECTION DEVELOPING', level:'ACTIVE CORRECTION', color:'#f39c12', confidence:90,
      ...base,
      reasons:[
        meaningfulDecline ? `Drop from peak ${rawDropFromPeak.toFixed(1)}%` : null,
        lowerHigh ? 'Lower-high structure detected' : null,
        rsiFalling ? 'Short-term RSI weakness' : null,
        belowShort15 ? 'Price below short-term 15m EMAs' : null,
        `15m EMA200 stretch ${ema200Stretch15.toFixed(2)}% — not yet confirmed significant correction`
      ].filter(Boolean)
    };
  }

  const exhaustionEvidence = volumeSpike4h >= 1.2 || wickRatio4h >= 1.2 || lowerHigh || rawDropFromPeak <= -15;
  if (rsi4h >= 85 && accum4h < 50 && exhaustionEvidence) {
    return {
      code:'HIGH_CORRECTION_RISK_MANIA', label:'🔥 HIGH CORRECTION RISK / MANIA', level:'PRE-CORRECTION', color:'#ff5722', confidence:90,
      ...base,
      reasons:[
        `4H RSI ${rsi4h.toFixed(1)}`, `Accumulation ${accumCombined.toFixed(0)}%`,
        volumeSpike4h >= 1.2 ? `Volume ×${volumeSpike4h.toFixed(2)}` : null,
        wickRatio4h >= 1.2 ? `Upper wick ${wickRatio4h.toFixed(2)}` : null,
        lowerHigh ? 'Lower-high structure' : null,
        rawDropFromPeak <= -15 ? `Drop ${rawDropFromPeak.toFixed(1)}%` : null
      ].filter(Boolean)
    };
  }

  const ema200Warning = ema200Stretch15 !== null && ema200Stretch15 > 12;
  if (rsi4h >= 78 && accum4h < 50 && (ema200Warning || lowerHigh || wickRatio4h >= 1.8 || rawDropFromPeak <= -15)) {
    return {
      code:'HIGH_CORRECTION_RISK', label:'🟡 HIGH CORRECTION RISK', level:'VULNERABILITY', color:'#f1c40f', confidence:80,
      ...base,
      reasons:[
        `4H RSI ${rsi4h.toFixed(1)}`, `Accumulation ${accumCombined.toFixed(0)}%`,
        ema200Warning ? `15m EMA200 stretch ${ema200Stretch15.toFixed(2)}%` : null,
        lowerHigh ? 'Lower-high structure' : null,
        wickRatio4h >= 1.8 ? `Upper wick ${wickRatio4h.toFixed(2)}` : null,
        rawDropFromPeak <= -15 ? `Drop ${rawDropFromPeak.toFixed(1)}%` : null
      ].filter(Boolean)
    };
  }

  if (rsi4h >= 80 && accumCombined >= 60) {
    return {
      code:'OVERBOUGHT_CONTINUATION_SUPPORTED', label:'🟢 OVERBOUGHT / CONTINUATION SUPPORTED', level:'CONTINUATION SUPPORT', color:'#2ecc71', confidence:75,
      ...base,
      reasons:[`4H RSI ${rsi4h.toFixed(1)}`, `Strong accumulation ${accumCombined.toFixed(0)}%`, 'Continuation support remains strong']
    };
  }

  if (rsi4h >= 76 && accumCombined >= 50 && accumCombined < 60) {
    return {
      code:'VULNERABILITY_INCREASING', label:'🟡 VULNERABILITY INCREASING', level:'WATCH', color:'#f1c40f', confidence:60,
      ...base,
      reasons:[`4H RSI ${rsi4h.toFixed(1)}`, `Moderate accumulation ${accumCombined.toFixed(0)}%`, 'Continuation support is weakening']
    };
  }

  if (rsi4h >= 80) {
    return {
      code:'OVERBOUGHT_STRONGLY_SUPPORTED', label:'⚪ OVERBOUGHT', level:'WATCH', color:'#95a5a6', confidence:50,
      ...base,
      reasons:[`4H RSI ${rsi4h.toFixed(1)}`, 'Extreme overbought condition', 'No significant-correction confirmation']
    };
  }

  return {
    code:'NO_SIGNIFICANT_CORRECTION_SIGNAL', label:'🟢 CONTINUATION / NO SIGNIFICANT CORRECTION', level:'LOW', color:'#2ecc71', confidence:25,
    ...base,
    reasons:['No significant correction confirmation', `4H RSI ${rsi4h.toFixed(1)}`, `Accumulation ${accumCombined.toFixed(0)}%`]
  };
}

/* ------------------------------
   RETURN TO NORMAL DETECTOR
   (same as before)
   ------------------------------ */
function detectReturnToNormal(item, opts = {}) {
  try {
    const k4 = item.k4h || [];
    if(k4.length < 20) {
      return { isReturn:false, score:0, reasons:["not enough data"], confidence:0 };
    }

    const closes = k4.map(c => Number(c[4]));
    const highs   = k4.map(c => Number(c[2]));
    const vols    = k4.map(c => Number(c[5]));
    const closeNow = item.closeNow || closes[closes.length-1];

    // 1. Drop from peak ≥ 15%
    const peak = Math.max(...highs.slice(-40));
    const dropPct = ((closeNow - peak) / peak) * 100;
    const dropOK = dropPct <= -15;

    // 2. Weak bounce = lower highs forming
    let lowerHighs = 0;
    for(let i = highs.length - 5; i < highs.length - 1; i++){
      if(highs[i+1] < highs[i]) lowerHighs++;
    }
    const bounceWeak = lowerHighs >= 2;

    // 3. Declining volume on bounce
    const recentVol = vols[vols.length - 1];
    const prevVol = sma(vols.slice(-10), 5) || vols[vols.length-2];
    const bounceVolOK = recentVol < prevVol * 0.7;

    // 4. Bounce fails below EMA14/EMA21
    const ema14 = ema(closes, 14);
    const ema21 = ema(closes, 21);
    const belowEMA = closeNow < ema14 && closeNow < ema21;

    // 5. Momentum weak: small candles + small wicks
    const last = k4[k4.length-1];
    const wickRatio = (Number(last[2]) - Number(last[3])) / (Math.abs(Number(last[1]) - Number(last[4])) + 1e-9);
    const volSpike = recentVol / (sma(vols, 10) || 1);
    const momentumWeak = wickRatio < 2 && volSpike < 1.5;

    // Score
    let score = 0;
    const reasons = [];
    if(dropOK){ score++; reasons.push("Strong drop from peak (≥15%)"); }
    if(bounceWeak){ score++; reasons.push("Lower highs on bounce (weak bounce)"); }
    if(bounceVolOK){ score++; reasons.push("Declining volume on bounce"); }
    if(belowEMA){ score++; reasons.push("Bounce capped by EMA14/EMA21"); }
    if(momentumWeak){ score++; reasons.push("Momentum weak (small candles / weak wicks)"); }

    const isReturn = score >= 3;
    const confidence = Math.round((score / 5) * 100);

    return { isReturn, score, reasons, confidence, meta:{dropPct, lowerHighs, wickRatio, volSpike} };

  } catch(err) {
    return { isReturn:false, score:0, reasons:[`error: ${err.message}`], confidence:0 };
  }
}
  

/* --------------------------
   PRE-CRASH / BLOWOFF DETECTOR
-------------------------- */
function detectPreCrash(item, opts={}) {
  const sensitivity = parseInt(el.sensitivity.value,10) || 50;
  const t = {
    rsi4h: 78 - Math.round((sensitivity-50)/2),
    volSpike4: 2.0 - (sensitivity-50)/250,
    wickRatio: 1.2 - (sensitivity-50)/500,
    emaDistPct: 40 - Math.round((sensitivity-50)/1.5),
    dropFromPeak: 8 - Math.round((sensitivity-50)/10)
  };

  try {
    const rsi4h = item.rsi4h || 0;
    const vol = Number(item.volSpike4 || 0);
    const wick = Number(item.wickRatio4 || 0);
    const emaDist = Math.abs(Number(item.ema70DistPct || 0));
    const dropPct = Number(item.dropPctFromPeak || 0);
    const funding = item.fundingRate || 0;

    // lower-highs count from k4h if present
    let lowerHCount = 0;
    if(Array.isArray(item.k4h) && item.k4h.length >= 6){
      const highs = item.k4h.slice(-8).map(k => Number(k[2]));
      for(let i=1;i<highs.length;i++) if(highs[i] < highs[i-1]) lowerHCount++;
    }

    let score = 0; const reasons = [];

    // core blowoff signals
    if(vol >= Math.max(1.8, t.volSpike4)){ score += 3; reasons.push(`Vol spike ×${vol}`); }
    else if(vol >= Math.max(1.2, t.volSpike4*0.7)){ score += 1; reasons.push(`Vol uptick ×${vol}`); }

    if(wick >= Math.max(1.2, t.wickRatio)){ score += 3; reasons.push(`Upper wick ratio ${wick.toFixed(2)}`); }
    else if(wick >= Math.max(0.9, t.wickRatio*0.7)){ score += 1; reasons.push(`Wick present ${wick.toFixed(2)}`); }

    if(rsi4h >= t.rsi4h){ score += 2; reasons.push(`RSI4H ${Math.round(rsi4h)}`); }
    else if(rsi4h >= t.rsi4h - 8){ score += 1; reasons.push(`RSI elevated ${Math.round(rsi4h)}`); }

    if(emaDist >= Math.max(30, t.emaDistPct)){ score += 2; reasons.push(`EMA70 stretch ${emaDist >= 0 ? "+" : ""}${emaDist.toFixed(2)}%`); }

    if(lowerHCount >= 2){ score += 2; reasons.push(`Lower highs (${lowerHCount})`); }
    if(dropPct >= Math.max(6, t.dropFromPeak)){ score += 1; reasons.push(`Actual decline from recent peak ${dropPct.toFixed(1)}%`); }

    if(typeof funding === 'number' && funding < -0.001){ score += 1; reasons.push(`Funding neg ${(funding*100).toFixed(3)}%`); }

    // reduce score if accumulation looks strong
    const accumConf = item.accumCombined ? (item.accumCombined.confidence || 0) : 0;
    if(accumConf >= 60){ score = Math.max(0, score - 2); reasons.push('Strong accumulation reduces immediate crash odds'); }

    const maxScore = 13;
    const confidence = Math.round((score / maxScore) * 100);
    const likely = (score >= 7 && confidence >= 45 && accumConf < 65) || (score >= 9);

    return { likely, score, reasons, confidence, meta: { rsi4h, vol, wick, emaDist, dropPct, funding, lowerHCount, accumConf } };
  } catch(err){
    return { likely:false, score:0, reasons:[`error ${err.message}`], confidence:0, meta:{} };
  }
}

/* ---------- SAFE FETCH ---------- */
async function safeFetch(url, opts = { allowIfNotRunning: false }) {
  if(!running && !opts.allowIfNotRunning) throw new Error('Not running (call Start first)');
  try {
    requestsThisWindow++;
    const r = await fetch(url);
    if(!r.ok) {
      const body = await r.text().catch(()=>'<no body>');
      throw new Error(`HTTP ${r.status} ${r.statusText} — ${body.slice(0,200)}`);
    }
    return await r.json();
  } catch (err) {
    throw new Error(`fetch error for ${url} → ${err.message}`);
  }
}

function resetWindow(){ requestsThisWindow=0; windowStart=Date.now(); }
function checkSafetyAndMaybePause(){
  const now=Date.now();
  if(now-windowStart > SAFETY_WINDOW_MS){ resetWindow(); el.safetyStatus.innerText='Safety OK'; return false; }
  if(requestsThisWindow > SAFETY_MAX){
    running=false;
    el.safetyStatus.innerText = `Auto-paused: ${requestsThisWindow} req/min`;
    el.message.innerText = `Auto-paused ${SAFETY_PAUSE}s to avoid rate limit.`;
    el.startBtn.disabled=false; el.stopBtn.disabled=true;
    setTimeout(()=>{ resetWindow(); const cur = Math.max(200, parseInt(el.delay.value,10)||450); el.delay.value = Math.min(2000, Math.round(cur * 1.5)); el.safetyStatus.innerText='Resumed after pause'; el.message.innerText='Resumed'; }, SAFETY_PAUSE*1000);
    return true;
  }
  el.safetyStatus.innerText = `Req/min: ${requestsThisWindow}`;
  return false;
}

