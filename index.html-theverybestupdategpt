function dot(a,b){ let s=0; for(let i=0;i<a.length;i++) s+=a[i]*b[i]; return s; }
function norm(a){ return Math.sqrt(a.reduce((s,x)=>s+x*x,0)); }
function cosineSim(a,b){ const n=dot(a,b); const d=norm(a)*norm(b); return d===0?0:n/d; }
function makeFeatureVector(item){
  item=item||{};
  const rsi4h = Math.min(100, item.rsi4h || 0)/100;
  const vol = Math.min(10, item.volSpike4 || 1)/5;
  const wick = Math.min(10, item.wickRatio4 || 0)/5;
  const ema = Math.min(500, Math.abs(item.ema70DistPct || 0))/200;
  const funding = (item.fundingRate || 0) * 1000;
  const slope = Math.min(4, Math.max(0, (item.slope15 || 1)/1.5))/2;
  const drop = Math.min(100, item.dropPctFromPeak || 0)/100;
  const accumConf = item.accumCombined ? (item.accumCombined.confidence || 0)/100 : 0;
  return [rsi4h,vol,wick,ema,funding,slope,drop,accumConf];
}
const FULL_CYCLE_REFERENCE_VECTOR = makeFeatureVector(FULL_CYCLE_REFERENCE);
function calculateBlowoffMatch(item){
  item=item||{}; const r1=Number(item.rsi1d),r4=Number(item.rsi4h),v=Number(item.volSpike4),w=Number(item.wickRatio4),e=Math.abs(Number(item.ema70DistPct)||0),f=Number(item.fundingRate)||0;
  const parts=[[Number.isFinite(r1)?Math.max(0,Math.min(1,(r1-60)/35)):0,20],[Math.max(0,Math.min(1,(r4-60)/35)),20],[Math.max(0,Math.min(1,(v-1)/4)),20],[Math.max(0,Math.min(1,(w-0.8)/3.2)),15],[Math.max(0,Math.min(1,(e-20)/130)),15],[item.lowerHigh?1:0,5],[Math.max(0,Math.min(1,(-f-0.0005)/0.0015)),5]];
  const weight=parts.reduce((a,p)=>a+p[1],0); return Math.round(parts.reduce((a,p)=>a+p[0]*p[1],0)/weight*100);
}
function applyCycleScores(item){
  if(!item)return item;
  item.similarity=cosineSim(makeFeatureVector(item),FULL_CYCLE_REFERENCE_VECTOR);
  item.cycleMatch=Math.round(item.similarity*100);
